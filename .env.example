# Local LLM — Ollama (no API key required)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_TIMEOUT=600

# Pexels stock video API — https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key
PEXELS_VIDEOS_PER_TAG=3

# ElevenLabs TTS — https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_DEFAULT_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
ELEVENLABS_MODEL=eleven_turbo_v2_5
CONTENT_LANGUAGE=English
MIN_VIDEO_SECONDS=30
MAX_VIDEO_SECONDS=60
SPEECH_WORDS_PER_MINUTE=150
# MIN_SCRIPT_WORDS / MAX_SCRIPT_WORDS auto-calculated from above unless set
MAX_SHORTS_DESCRIPTION_CHARS=100
YOUTUBE_DECLARE_SYNTHETIC_MEDIA=true

# YouTube OAuth — download from Google Cloud Console
GOOGLE_CLIENT_SECRETS=config/client_secrets.json
# Must match PORT and Google Console → Authorized redirect URIs
OAUTH_REDIRECT_URI=http://127.0.0.1:5000/oauth/youtube/callback

# Publishing schedule — auto Schedule: one video per channel per day at this local time
# SCHEDULE_DISPLAY_TIMEZONE = clock timezone for DAILY_HOUR:MINUTE (Planla + panel labels)
SCHEDULE_DISPLAY_TIMEZONE=Europe/Istanbul
SCHEDULE_DAILY_HOUR=20
SCHEDULE_DAILY_MINUTE=0
# Optional: SCHEDULE_MIN_LEAD_MINUTES=60
# Optional US peak mode: SCHEDULE_US_PEAK_HOURS=true  SCHEDULE_TIMEZONE=America/New_York

DAEMON_INTERVAL_SECONDS=300

# App server
HOST=127.0.0.1
PORT=5000
